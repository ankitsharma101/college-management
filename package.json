{
  "name": "saarthi-jecrc-chatbot",
  "version": "1.0.0",
  "description": "Saarthi - Complete JECRC Multilingual Chatbot System",
  "private": true,
  "scripts": {
    "setup": "npm run setup:backend && npm run setup:frontend && npm run setup:chatbot",
    "setup:backend": "cd backend && npm install",
    "setup:frontend": "cd frontend && npm install", 
    "setup:chatbot": "cd chatbot-service && pip install -r requirements.txt",
    
    "start:chatbot": "cd chatbot-service && python3 enhanced_app.py",
    "start:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && npm start",
    
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    
    "clean": "npm run clean:backend && npm run clean:frontend && npm run clean:chatbot",
    "clean:backend": "cd backend && rm -rf dist node_modules",
    "clean:frontend": "cd frontend && rm -rf build node_modules",
    "clean:chatbot": "cd chatbot-service && rm -rf venv __pycache__"
  },
  "keywords": [
    "saarthi",
    "jecrc", 
    "chatbot",
    "multilingual",
    "hindi",
    "english", 
    "rajasthani",
    "flask",
    "react",
    "nodejs",
    "education"
  ],
  "author": "JECRC Foundation Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "python": ">=3.8.0"
  }
}
